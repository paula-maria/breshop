generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENTE
  PROPRIETARIO
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(CLIENTE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  brecho    Brecho?
  chats     Chat[]
  mensagens Mensagem[]
  favoritos Favorito[]
  avaliacoes Avaliacao[]
  propostas Proposta[]
}

model Brecho {
  id          String   @id @default(uuid())
  // 01 - Informações Básicas
  nome        String
  descricao   String?
  logoUrl     String?
  capaUrl     String?

  // 02 - Contatos
  telefone    String?
  whatsapp    String
  emailContato String?
  instagram   String?
  site        String?

  // 03 - Endereço
  cep         String?
  rua         String?
  numero      String?
  complemento String?
  bairro      String?
  cidade      String?
  estado      String?

  // 05 - Funcionamento
  horarios    String?

  // 06 - Comercial
  formasPagamento String[]
  atendimento     String?
  entrega         Boolean  @default(false)
  retirada        Boolean  @default(false)
  negociacao      Boolean  @default(false)

  // Relacionamentos
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id])
  pecas       Peca[]
  chats       Chat[]
  avaliacoes  Avaliacao[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Peca {
  id          String   @id @default(uuid())
  nome        String
  descricao   String?
  preco       Float
  tamanho     String
  categoria   String
  condicao    String
  fotos       String[]
  disponivel  Boolean  @default(true)
  brechoId    String
  brecho      Brecho   @relation(fields: [brechoId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  chats       Chat[]
  favoritos   Favorito[]
  propostas   Proposta[]
}

model Chat {
  id        String   @id @default(uuid())
  pecaId    String?
  peca      Peca?    @relation(fields: [pecaId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  brechoId  String
  brecho    Brecho   @relation(fields: [brechoId], references: [id])
  
  mensagens Mensagem[]
  propostas Proposta[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Mensagem {
  id        String   @id @default(uuid())
  content   String
  chatId    String
  chat      Chat     @relation(fields: [chatId], references: [id])
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id])
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

enum StatusProposta {
  PENDENTE
  ACEITA
  RECUSADA
  CONTRAPROPOSTA
}

model Proposta {
  id        String   @id @default(uuid())
  valor     Float
  status    StatusProposta @default(PENDENTE)
  
  chatId    String
  chat      Chat     @relation(fields: [chatId], references: [id])
  
  pecaId    String
  peca      Peca     @relation(fields: [pecaId], references: [id])
  
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Favorito {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  pecaId    String
  peca      Peca     @relation(fields: [pecaId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, pecaId])
}

model Avaliacao {
  id        String   @id @default(uuid())
  nota      Int      // 1 a 5
  comentario String?
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  brechoId  String
  brecho    Brecho   @relation(fields: [brechoId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, brechoId])
}
